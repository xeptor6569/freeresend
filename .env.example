# FreeResend configuration for docker compose.
# setup.ps1 / setup.sh creates .env from this file and fills in the secrets.
# After editing .env, apply changes with: docker compose up -d

# Dashboard login. Changing ADMIN_PASSWORD and restarting resets the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Amazon SES. The IAM permissions needed are listed in README.md.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: DigitalOcean API token for automatic DNS record creation.
DO_API_TOKEN=

# Generated secrets. Changing JWT_SECRET signs everyone out.
# POSTGRES_PASSWORD cannot be changed here after the first start.
JWT_SECRET=
POSTGRES_PASSWORD=

# Host port for the dashboard and API. Set to 127.0.0.1:3000 to only allow
# access through the HTTPS proxy below.
APP_PORT=3000

# Optional HTTPS through the bundled Caddy proxy. Point this domain's DNS at
# the server, then run: docker compose --profile https up -d
APP_DOMAIN=

# Optional: use an external Postgres instead of the bundled one.
# Start with: docker compose up -d --no-deps app
DATABASE_URL=
DATABASE_SSL=false
